# Copy to .env.local. Keep local credentials out of Git.
APP_MODE=demo
POSTGRES_USER=marshrut
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=marshrut
POSTGRES_PORT=5432
# Optional in demo, required in pilot and by all db:* commands.
# URL-encode reserved characters in credentials.
DATABASE_URL=postgresql://marshrut:replace-with-a-local-password@127.0.0.1:5432/marshrut
DATABASE_POOL_MAX=5

# Feature implementations belong to later stages. Defaults stay disabled.
DOCUMENT_UPLOAD_ENABLED=false
AI_EXTRACTION_ENABLED=false
PDF_EXPORT_ENABLED=false
PROVIDER_SELF_SERVICE_ENABLED=false
